---
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f7f3" />
    <meta name="description" content="Reparte los gastos de una salida y descubre quién le debe a quién." />
    <title>Vaquita — cuentas claras entre amigos</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="min-h-screen">
      <header class="border-b border-line bg-white/80">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-8">
          <a href="#inicio" class="flex items-center gap-3 rounded-xl" aria-label="Vaquita, inicio">
            <span class="grid size-10 place-items-center rounded-2xl bg-leaf text-white shadow-sm shadow-leaf/20">
              <svg viewBox="0 0 24 24" class="size-6" fill="none" aria-hidden="true">
                <path d="M5.5 13.5c1.4 0 2.2-1 3.1-2.1 1.1-1.4 2.2-2.9 4.8-2.9 2.2 0 3.7 1.3 4.5 3M4 17.5h16M7 18v1.5m10-1.5v1.5M8 8.5l1-2m7 2 1-2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="17.5" cy="5.5" r=".8" fill="currentColor" />
              </svg>
            </span>
            <span>
              <span class="block text-base font-bold tracking-tight">vaquita</span>
              <span class="block text-xs text-muted">Cuentas claras, buenos planes</span>
            </span>
          </a>
          <div class="flex items-center gap-2">
            <label for="trip-switcher" class="sr-only">Cambiar de salida</label>
            <select id="trip-switcher" class="max-w-36 rounded-lg border border-line bg-white px-2.5 py-2 text-sm font-semibold text-ink sm:max-w-48" aria-label="Cambiar de salida"></select>
            <button id="share-trip" type="button" class="rounded-lg border border-leaf px-3 py-2 text-sm font-semibold text-leaf transition hover:bg-[#eef6ef]">Compartir</button>
            <button id="clear-trip" type="button" class="rounded-lg px-3 py-2 text-sm font-semibold text-muted transition hover:bg-paper hover:text-ink">Nueva salida</button>
          </div>
        </div>
      </header>

      <aside id="shared-banner" hidden class="border-b border-[#cfe5d2] bg-[#eff8ef]">
        <div class="mx-auto flex max-w-7xl flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-8">
          <p id="shared-message" class="text-sm leading-6 text-[#315c3b]" role="status"></p>
          <div class="flex shrink-0 gap-2">
            <button id="save-shared-copy" type="button" class="rounded-xl bg-leaf px-4 py-2.5 text-sm font-bold text-white transition hover:bg-leaf-dark">Guardar copia</button>
            <button id="leave-shared-preview" type="button" class="rounded-xl border border-[#b9d8be] bg-white px-4 py-2.5 text-sm font-semibold text-[#315c3b] transition hover:bg-[#f6fbf6]">Volver a mis salidas</button>
          </div>
        </div>
      </aside>

      <main id="inicio" class="mx-auto max-w-7xl px-5 pb-16 pt-8 sm:px-8 sm:pt-12">
        <section class="mb-8 flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
          <div>
            <p class="mb-2 text-sm font-semibold uppercase tracking-[0.16em] text-leaf">Tu grupo, en equilibrio</p>
            <label for="trip-name" class="sr-only">Nombre de la salida</label>
            <input id="trip-name" class="w-full max-w-2xl border-0 bg-transparent p-0 text-3xl font-bold tracking-tight text-ink placeholder:text-gray-300 focus:outline-none sm:text-4xl" maxlength="60" value="Nuestra salida" />
            <p class="mt-2 text-sm text-muted">Añade los gastos y deja que las cuentas se ordenen solas.</p>
          </div>
          <div class="flex items-center gap-2 self-start rounded-full border border-line bg-white px-3.5 py-2 text-sm text-muted sm:self-auto">
            <span class="size-2 rounded-full bg-[#73b78c]"></span>
            <span id="save-status">Guardado en este dispositivo</span>
            <span id="share-status" class="text-xs font-medium text-leaf" role="status" aria-live="polite"></span>
          </div>
        </section>

        <div class="grid items-start gap-6 lg:grid-cols-[290px_minmax(0,1fr)]">
          <aside class="space-y-5">
            <section class="rounded-3xl border border-line bg-white p-5 shadow-sm shadow-ink/[0.025] sm:p-6">
              <div class="mb-5 flex items-center justify-between">
                <div>
                  <h2 class="font-bold tracking-tight">El grupo</h2>
                  <p id="people-count" class="mt-1 text-sm text-muted">0 personas</p>
                </div>
                <span class="grid size-10 place-items-center rounded-2xl bg-[#eef6ef] text-leaf">
                  <svg viewBox="0 0 24 24" class="size-5" fill="none" aria-hidden="true"><path d="M16 20v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 18.5V20m14-9a3 3 0 0 1 2 2.83V15m-5-11.7a3 3 0 0 1 0 5.83M10 12a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
              </div>
              <ul id="people-list" class="mb-5 space-y-2" aria-label="Participantes"></ul>
              <p id="people-empty" class="mb-5 rounded-2xl bg-paper px-4 py-3 text-sm leading-6 text-muted">Empieza añadiendo a quienes compartirán los gastos.</p>
              <form id="person-form" class="flex gap-2">
                <label for="person-name" class="sr-only">Nombre del participante</label>
                <input id="person-name" type="text" maxlength="30" placeholder="Nombre" autocomplete="off" class="min-w-0 flex-1 rounded-xl border border-line bg-white px-3.5 py-2.5 text-sm placeholder:text-gray-400" />
                <button type="submit" aria-label="Añadir participante" class="grid size-11 shrink-0 place-items-center rounded-xl bg-leaf text-white transition hover:bg-leaf-dark">
                  <svg viewBox="0 0 24 24" class="size-5" fill="none" aria-hidden="true"><path d="M12 5v14m-7-7h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
                </button>
              </form>
              <p id="person-error" class="mt-2 min-h-4 text-xs text-red-600" role="status"></p>
            </section>

            <section class="rounded-3xl bg-[#eaf3eb] p-5 sm:p-6">
              <div class="mb-3 flex items-center gap-2 text-leaf">
                <svg viewBox="0 0 24 24" class="size-5" fill="none" aria-hidden="true"><path d="M12 3.5 19 7v5c0 4.3-3 7.3-7 8.5-4-1.2-7-4.2-7-8.5V7l7-3.5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <h2 class="text-sm font-bold">Sin cuentas pendientes</h2>
              </div>
              <p class="text-sm leading-6 text-[#536b58]">Tus datos se guardan solo en este navegador y no se sincronizan entre dispositivos.</p>
            </section>
          </aside>

          <div class="space-y-6">
            <section class="rounded-3xl bg-[#1f6847] p-6 text-white shadow-lg shadow-[#1f6847]/10 sm:p-8">
              <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-center">
                <div>
                  <p class="text-sm font-medium text-white/70">Balance de la salida</p>
                  <p id="group-total" class="mt-2 text-3xl font-bold tracking-tight">S/. 0.00</p>
                  <p id="balance-caption" class="mt-2 text-sm text-white/70">Añade participantes y gastos para empezar.</p>
                </div>
                <div class="grid size-16 shrink-0 place-items-center rounded-3xl bg-white/10 sm:size-20">
                  <svg viewBox="0 0 24 24" class="size-9" fill="none" aria-hidden="true"><path d="M4 7.5h16v11H4v-11Zm0 0 2.5-3h11L20 7.5M4 11h16m-5 4h2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /><circle cx="8" cy="15" r=".8" fill="currentColor" /></svg>
                </div>
              </div>
              <div id="balance-list" class="mt-6 grid gap-2 sm:grid-cols-2 xl:grid-cols-3" aria-live="polite"></div>
            </section>

            <section class="rounded-3xl border border-line bg-white p-5 shadow-sm shadow-ink/[0.025] sm:p-7">
              <div class="mb-6 flex items-start justify-between gap-4">
                <div>
                  <p class="text-xs font-bold uppercase tracking-[0.15em] text-leaf">Nuevo movimiento</p>
                  <h2 class="mt-1 text-xl font-bold tracking-tight">Añadir un gasto</h2>
                  <p class="mt-1 text-sm text-muted">¿Quién pagó y entre quiénes se reparte?</p>
                </div>
                <span class="grid size-10 shrink-0 place-items-center rounded-2xl bg-[#eef6ef] text-leaf">
                  <svg viewBox="0 0 24 24" class="size-5" fill="none" aria-hidden="true"><path d="M12 5v14m-7-7h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
                </span>
              </div>
              <form id="expense-form" class="space-y-5">
                <div class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_170px]">
                  <div>
                    <label for="expense-description" class="mb-1.5 block text-sm font-semibold">Concepto</label>
                    <input id="expense-description" type="text" maxlength="70" placeholder="Ej. Cena, gasolina…" class="w-full rounded-xl border border-line bg-white px-3.5 py-3 text-sm placeholder:text-gray-400" />
                  </div>
                  <div>
                    <label for="expense-amount" class="mb-1.5 block text-sm font-semibold">Importe</label>
                    <div class="relative">
                      <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-muted">S/.</span>
                      <input id="expense-amount" type="number" min="0.01" step="0.01" inputmode="decimal" placeholder="0.00" class="w-full rounded-xl border border-line bg-white py-3 pl-12 pr-3.5 text-sm placeholder:text-gray-400" />
                    </div>
                  </div>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                  <div>
                    <label for="expense-payer" class="mb-1.5 block text-sm font-semibold">Lo pagó</label>
                    <select id="expense-payer" class="w-full rounded-xl border border-line bg-white px-3.5 py-3 text-sm text-ink disabled:bg-paper disabled:text-muted" disabled><option value="">Añade participantes primero</option></select>
                  </div>
                  <div>
                    <label for="split-mode" class="mb-1.5 block text-sm font-semibold">Cómo repartir</label>
                    <select id="split-mode" class="w-full rounded-xl border border-line bg-white px-3.5 py-3 text-sm text-ink"><option value="equal">A partes iguales</option><option value="custom">Importe por persona</option></select>
                  </div>
                </div>
                <fieldset>
                  <legend class="mb-2 text-sm font-semibold">¿Quiénes participan?</legend>
                  <div id="expense-participants" class="grid gap-2 sm:grid-cols-2"></div>
                  <p id="participants-empty" class="rounded-xl bg-paper px-4 py-3 text-sm text-muted">Añade participantes al grupo para poder repartir gastos.</p>
                </fieldset>
                <p id="expense-error" class="min-h-4 text-sm text-red-600" role="status"></p>
                <div class="flex justify-end border-t border-line pt-4">
                  <button id="expense-submit" type="submit" class="w-full rounded-xl bg-leaf px-5 py-3 text-sm font-bold text-white transition hover:bg-leaf-dark disabled:cursor-not-allowed disabled:bg-gray-300 sm:w-auto">Guardar gasto</button>
                </div>
              </form>
            </section>

            <section class="grid gap-6 xl:grid-cols-2">
              <div class="rounded-3xl border border-line bg-white p-5 shadow-sm shadow-ink/[0.025] sm:p-6">
                <div class="mb-5 flex items-center justify-between">
                  <div>
                    <h2 class="font-bold tracking-tight">Gastos</h2>
                    <p id="expense-count" class="mt-1 text-sm text-muted">Aún no hay gastos</p>
                  </div>
                  <span class="grid size-10 place-items-center rounded-2xl bg-[#fbf2e6] text-[#a8752b]">
                    <svg viewBox="0 0 24 24" class="size-5" fill="none" aria-hidden="true"><path d="M6 4.5h12v15H6v-15Zm3 4h6m-6 4h6m-6 4h3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </span>
                </div>
                <ul id="expense-list" class="space-y-3" aria-label="Gastos registrados"></ul>
                <p id="expenses-empty" class="rounded-2xl bg-paper px-4 py-4 text-sm leading-6 text-muted">Los gastos que añadas aparecerán aquí.</p>
              </div>

              <div class="rounded-3xl border border-line bg-white p-5 shadow-sm shadow-ink/[0.025] sm:p-6">
                <div class="mb-5 flex items-center justify-between">
                  <div>
                    <h2 class="font-bold tracking-tight">Pagos sugeridos</h2>
                    <p class="mt-1 text-sm text-muted">Para saldar las cuentas con menos lío.</p>
                  </div>
                  <span class="grid size-10 place-items-center rounded-2xl bg-[#eef6ef] text-leaf">
                    <svg viewBox="0 0 24 24" class="size-5" fill="none" aria-hidden="true"><path d="M5 8h14m0 0-3-3m3 3-3 3M19 16H5m0 0 3-3m-3 3 3 3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </span>
                </div>
                <ul id="suggestion-list" class="space-y-3" aria-label="Pagos para saldar"></ul>
                <p id="suggestions-empty" class="rounded-2xl bg-paper px-4 py-4 text-sm leading-6 text-muted">Cuando haya gastos, aquí verás cómo saldar las cuentas.</p>
              </div>
            </section>

            <section class="rounded-3xl border border-line bg-white p-5 shadow-sm shadow-ink/[0.025] sm:p-7">
              <div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
                <div>
                  <p class="text-xs font-bold uppercase tracking-[0.15em] text-leaf">Ajusta cuentas</p>
                  <h2 class="mt-1 text-xl font-bold tracking-tight">Registrar un pago</h2>
                  <p class="mt-1 text-sm text-muted">Anota una transferencia que ya se hizo.</p>
                </div>
              </div>
              <form id="transfer-form" class="grid gap-3 sm:grid-cols-2 xl:grid-cols-[1fr_1fr_150px_auto] xl:items-end">
                <div>
                  <label for="transfer-from" class="mb-1.5 block text-sm font-semibold">Quién envió</label>
                  <select id="transfer-from" class="w-full rounded-xl border border-line bg-white px-3.5 py-3 text-sm text-ink disabled:bg-paper disabled:text-muted" disabled><option value="">Añade participantes</option></select>
                </div>
                <div>
                  <label for="transfer-to" class="mb-1.5 block text-sm font-semibold">Quién recibió</label>
                  <select id="transfer-to" class="w-full rounded-xl border border-line bg-white px-3.5 py-3 text-sm text-ink disabled:bg-paper disabled:text-muted" disabled><option value="">Añade participantes</option></select>
                </div>
                <div>
                  <label for="transfer-amount" class="mb-1.5 block text-sm font-semibold">Importe</label>
                  <div class="relative">
                    <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-sm text-muted">S/.</span>
                    <input id="transfer-amount" type="number" min="0.01" step="0.01" inputmode="decimal" placeholder="0.00" class="w-full rounded-xl border border-line bg-white py-3 pl-12 pr-3.5 text-sm placeholder:text-gray-400" />
                  </div>
                </div>
                <button id="transfer-submit" type="submit" class="rounded-xl border border-leaf px-4 py-3 text-sm font-bold text-leaf transition hover:bg-[#eef6ef] disabled:cursor-not-allowed disabled:border-gray-300 disabled:text-gray-400">Registrar pago</button>
              </form>
              <p id="transfer-error" class="mt-2 min-h-4 text-sm text-red-600" role="status"></p>
              <div class="mt-5 border-t border-line pt-5">
                <div class="mb-3 flex items-center justify-between">
                  <h3 class="text-sm font-bold">Pagos registrados</h3>
                  <span id="transfer-count" class="text-xs text-muted">0 pagos</span>
                </div>
                <ul id="transfer-list" class="space-y-2" aria-label="Pagos ya realizados"></ul>
                <p id="transfers-empty" class="text-sm text-muted">Todavía no se han anotado pagos.</p>
              </div>
            </section>
          </div>
        </div>
        <footer class="mt-10 text-center text-xs text-muted">Hecho para disfrutar más y cuadrar menos.</footer>
      </main>
    </div>
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
